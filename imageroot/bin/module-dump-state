set -e

if systemctl --user -q is-active gitlab-app; then
    podman exec gitlab-app gitlab-backup create \
        SKIP=repositories,uploads,builds,artifacts,lfs,terraform_state,ci_secure_files,pages,registry,packages \
        CRON=1
fi
