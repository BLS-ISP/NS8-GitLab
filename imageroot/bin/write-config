import base64
import json
import os
import sys
import agent
from agent.ldapproxy import Ldapproxy


def ruby_str(value):
    """Return a safely escaped Ruby string expression using JSON.parse."""
    return f"JSON.parse({json.dumps(json.dumps(str(value)))})"


def ruby_json(value):
    """Return a safely escaped Ruby object/array expression using JSON.parse."""
    return f"JSON.parse({json.dumps(json.dumps(value))})"


env = dict(os.environ)
if os.path.exists("environment"):
    try:
        env.update(agent.read_envfile("environment"))
    except Exception as ex:
        print(agent.SD_WARNING + f"Failed to read environment file: {ex}", file=sys.stderr)

secret_vars = {}
if os.path.exists("passwords.env"):
    try:
        secret_vars.update(agent.read_envfile("passwords.env"))
    except Exception as ex:
        print(agent.SD_WARNING + f"Failed to read passwords.env file: {ex}", file=sys.stderr)

# Ensure state/gitlab-custom.rb (mode 0600) always exists before podman bind-mounts it
custom_rb_path = "gitlab-custom.rb"
if not os.path.exists(custom_rb_path):
    with open(custom_rb_path, "w", encoding="utf-8", newline="\n") as cfile:
        cfile.write("")
    os.chmod(custom_rb_path, 0o600)
else:
    os.chmod(custom_rb_path, 0o600)

# Render or remove custom CA certificate (state/ns8-custom-ca.crt & state/trusted-certs/ns8-custom-ca.crt)
os.makedirs("trusted-certs", mode=0o700, exist_ok=True)
ca_cert_path = "ns8-custom-ca.crt"
staged_ca_cert_path = os.path.join("trusted-certs", "ns8-custom-ca.crt")
custom_ca_b64 = secret_vars.get("CUSTOM_CA_CERT_B64", "").strip()
custom_ca_pem = ""
if custom_ca_b64:
    try:
        custom_ca_pem = (
            base64.b64decode(custom_ca_b64).decode("utf-8").replace("\r\n", "\n").replace("\r", "\n").strip()
        )
    except Exception as ex:
        print(agent.SD_WARNING + f"Failed to decode CUSTOM_CA_CERT_B64: {ex}", file=sys.stderr)
        custom_ca_pem = ""

if custom_ca_pem:
    ca_payload = custom_ca_pem + "\n"
    for target_path in (ca_cert_path, staged_ca_cert_path):
        tmp_ca = f".ca-{os.getpid()}.tmp"
        with open(tmp_ca, "w", encoding="utf-8", newline="\n") as cafile:
            cafile.write(ca_payload)
        os.chmod(tmp_ca, 0o644)
        os.replace(tmp_ca, target_path)
else:
    for target_path in (ca_cert_path, staged_ca_cert_path):
        if os.path.exists(target_path):
            try:
                os.remove(target_path)
            except Exception as ex:
                print(agent.SD_WARNING + f"Failed to remove {target_path}: {ex}", file=sys.stderr)

host = env.get("HOST", "gitlab.local")
registry_url = env.get("GITLAB_REGISTRY_HOST", "")
ldap_domain = env.get("LDAP_DOMAIN", "")
ssh_port = env.get("GITLAB_SSH_PORT", "")
initial_password = secret_vars.get("GITLAB_INITIAL_PASSWORD", "")

smtp_settings = {}
try:
    rdb = agent.redis_connect(use_replica=True)
    smtp_settings = agent.get_smarthost_settings(rdb) or {}
except Exception as ex:
    print(agent.SD_WARNING + f"Could not read smarthost settings from Redis: {ex}", file=sys.stderr)

lines = [
    "# Generated automatically by NethServer 8 GitLab module",
    "require 'json'",
    "",
    "# Container runtime & resource tuning",
    "package['detect_init'] = false",
    "package['modify_kernel_parameters'] = false",
    "node_exporter['enable'] = false",
    "manage_accounts['enable'] = false",
    "prometheus_monitoring['enable'] = false",
    "postgresql['shared_buffers'] = '256MB'",
    "puma['worker_processes'] = 2",
    "sidekiq['concurrency'] = 10",
    "",
    "# External URL & Reverse Proxy (Traefik)",
    f"external_url {ruby_str(f'https://{host}')}",
    "nginx['listen_https'] = false",
    "nginx['listen_port'] = 80",
    "nginx['real_ip_trusted_addresses'] = ['127.0.0.1/8', '10.0.2.0/24']",
    "gitlab_rails['monitoring_whitelist'] = ['127.0.0.0/8', '::1/128', '10.0.2.0/24']",
    "nginx['real_ip_header'] = 'X-Forwarded-For'",
    "nginx['real_ip_recursive'] = 'on'",
    "nginx['proxy_set_headers'] = {",
    "  'X-Forwarded-Proto' => 'https',",
    "  'X-Forwarded-Ssl' => 'on'",
    "}",
]

if ssh_port and ssh_port.isdigit():
    lines.extend([
        "",
        "# Git over SSH Port",
        f"gitlab_rails['gitlab_shell_ssh_port'] = {int(ssh_port)}",
    ])

if initial_password and len(initial_password) >= 8:
    lines.extend([
        "",
        "# Initial Root Password",
        f"gitlab_rails['initial_root_password'] = {ruby_str(initial_password)}",
    ])

if registry_url:
    lines.extend([
        "",
        "# GitLab Container Registry",
        f"registry_external_url {ruby_str(f'https://{registry_url}')}",
        "gitlab_rails['registry_enabled'] = true",
        "registry_nginx['listen_https'] = false",
        "registry_nginx['listen_port'] = 5050",
        "registry_nginx['proxy_set_headers'] = {",
        "  'Host' => '$http_host',",
        "  'X-Real-IP' => '$remote_addr',",
        "  'X-Forwarded-For' => '$proxy_add_x_forwarded_for',",
        "  'X-Forwarded-Proto' => 'https',",
        "  'X-Forwarded-Ssl' => 'on'",
        "}",
    ])
else:
    lines.extend([
        "",
        "# GitLab Container Registry (disabled)",
        "gitlab_rails['registry_enabled'] = false",
        "registry['enable'] = false",
    ])

if ldap_domain:
    try:
        odom = Ldapproxy().get_domain(ldap_domain)
        if odom and "host" in odom and "port" in odom:
            is_ad = odom.get("schema") == "ad"
            uid_attr = "sAMAccountName" if is_ad else "uid"
            ldap_servers = {
                "main": {
                    "label": f"LDAP ({ldap_domain})",
                    "host": "10.0.2.2",
                    "port": int(odom["port"]),
                    "uid": uid_attr,
                    "bind_dn": odom.get("bind_dn", ""),
                    "password": odom.get("bind_password", ""),
                    "encryption": "plain",
                    "verify_certificates": False,
                    "active_directory": is_ad,
                    "allow_username_or_email_login": True,
                    "lowercase_usernames": False,
                    "block_auto_created_users": False,
                    "base": odom.get("base_dn", ""),
                }
            }
            lines.extend([
                "",
                "# LDAP / Active Directory Authentication",
                "gitlab_rails['ldap_enabled'] = true",
                "gitlab_rails['prevent_ldap_sign_in'] = false",
                f"gitlab_rails['ldap_servers'] = {ruby_json(ldap_servers)}",
            ])
        else:
            print(agent.SD_WARNING + f"LDAP domain '{ldap_domain}' not currently available in Ldapproxy", file=sys.stderr)
    except Exception as ex:
        print(agent.SD_WARNING + f"Failed to load LDAP domain '{ldap_domain}': {ex}", file=sys.stderr)
else:
    lines.extend([
        "",
        "gitlab_rails['ldap_enabled'] = false",
    ])

sso_enabled = env.get("SSO_ENABLED", "False") == "True"
omniauth_providers = []

if sso_enabled:
    # 1. NS8 Cluster SSO (openid_connect_ns8)
    ns8_sso_provider = env.get("NS8_SSO_PROVIDER", "").strip()
    ns8_sso_issuer = env.get("NS8_SSO_ISSUER", "").strip()
    ns8_sso_client_id = env.get("NS8_SSO_CLIENT_ID", "").strip()
    ns8_sso_client_secret = secret_vars.get("NS8_SSO_CLIENT_SECRET", "").strip()
    if ns8_sso_provider and ns8_sso_issuer and ns8_sso_client_id and ns8_sso_client_secret:
        omniauth_providers.append({
            "name": "openid_connect_ns8",
            "label": env.get("NS8_SSO_LABEL", "").strip() or "Single Sign-On",
            "args": {
                "name": "openid_connect_ns8",
                "strategy_class": "OmniAuth::Strategies::OpenIDConnect",
                "scope": ["openid", "profile", "email"],
                "response_type": "code",
                "issuer": ns8_sso_issuer,
                "discovery": True,
                "client_auth_method": "basic",
                "uid_field": "preferred_username",
                "send_scope_to_token_endpoint": False,
                "pkce": True,
                "client_options": {
                    "identifier": ns8_sso_client_id,
                    "secret": ns8_sso_client_secret,
                    "redirect_uri": f"https://{host}/users/auth/openid_connect_ns8/callback",
                },
            },
        })

    # 2. External OpenID Connect (openid_connect)
    oidc_issuer = env.get("OIDC_ISSUER", "").strip()
    oidc_client_id = env.get("OIDC_CLIENT_ID", "").strip()
    oidc_client_secret = secret_vars.get("OIDC_CLIENT_SECRET", "").strip()
    if env.get("OIDC_ENABLED", "False") == "True" and oidc_issuer and oidc_client_id and oidc_client_secret:
        oidc_scopes_raw = env.get("OIDC_SCOPES", "").strip() or "openid,profile,email"
        oidc_scopes_list = [s.strip() for s in oidc_scopes_raw.replace(" ", ",").split(",") if s.strip()] or [
            "openid",
            "profile",
            "email",
        ]
        omniauth_providers.append({
            "name": "openid_connect",
            "label": env.get("OIDC_LABEL", "").strip() or "OpenID Connect",
            "args": {
                "name": "openid_connect",
                "strategy_class": "OmniAuth::Strategies::OpenIDConnect",
                "scope": oidc_scopes_list,
                "response_type": "code",
                "issuer": oidc_issuer,
                "discovery": True,
                "client_auth_method": env.get("OIDC_CLIENT_AUTH_METHOD", "").strip() or "basic",
                "uid_field": env.get("OIDC_UID_FIELD", "").strip() or "preferred_username",
                "send_scope_to_token_endpoint": False,
                "pkce": env.get("OIDC_PKCE", "True") == "True",
                "client_options": {
                    "identifier": oidc_client_id,
                    "secret": oidc_client_secret,
                    "redirect_uri": f"https://{host}/users/auth/openid_connect/callback",
                },
            },
        })

    # 3. SAML 2.0 (saml)
    saml_idp_sso_target_url = env.get("SAML_IDP_SSO_TARGET_URL", "").strip()
    saml_idp_slo_target_url = env.get("SAML_IDP_SLO_TARGET_URL", "").strip()
    saml_idp_cert_fingerprint = env.get("SAML_IDP_CERT_FINGERPRINT", "").strip()
    saml_cert_b64 = secret_vars.get("SAML_IDP_CERT_B64", "").strip()
    saml_idp_cert_pem = ""
    if saml_cert_b64:
        try:
            saml_idp_cert_pem = (
                base64.b64decode(saml_cert_b64).decode("utf-8").replace("\r\n", "\n").replace("\r", "\n").strip()
            )
        except Exception as ex:
            print(agent.SD_WARNING + f"Failed to decode SAML_IDP_CERT_B64: {ex}", file=sys.stderr)
            saml_idp_cert_pem = ""
    if (
        env.get("SAML_ENABLED", "False") == "True"
        and saml_idp_sso_target_url
        and (saml_idp_cert_pem or saml_idp_cert_fingerprint)
    ):
        saml_args = {
            "assertion_consumer_service_url": f"https://{host}/users/auth/saml/callback",
            "idp_sso_target_url": saml_idp_sso_target_url,
            "issuer": env.get("SAML_ISSUER", "").strip() or f"https://{host}",
            "name_identifier_format": env.get("SAML_NAME_IDENTIFIER_FORMAT", "").strip()
            or "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
        }
        if saml_idp_slo_target_url:
            saml_args["idp_slo_target_url"] = saml_idp_slo_target_url
        if saml_idp_cert_pem:
            saml_args["idp_cert"] = saml_idp_cert_pem
        elif saml_idp_cert_fingerprint:
            saml_args["idp_cert_fingerprint"] = saml_idp_cert_fingerprint
        omniauth_providers.append({
            "name": "saml",
            "label": env.get("SAML_LABEL", "").strip() or "SAML 2.0",
            "args": saml_args,
        })

    # 4. Microsoft Entra ID (azure_activedirectory_v2)
    azure_client_id = env.get("AZURE_CLIENT_ID", "").strip()
    azure_client_secret = secret_vars.get("AZURE_CLIENT_SECRET", "").strip()
    azure_tenant_id = env.get("AZURE_TENANT_ID", "").strip()
    if (
        env.get("AZURE_ENABLED", "False") == "True"
        and azure_client_id
        and azure_client_secret
        and azure_tenant_id
    ):
        omniauth_providers.append({
            "name": "azure_activedirectory_v2",
            "label": env.get("AZURE_LABEL", "").strip() or "Microsoft Entra ID",
            "args": {
                "client_id": azure_client_id,
                "client_secret": azure_client_secret,
                "tenant_id": azure_tenant_id,
            },
        })

    # 5. GitHub / GitHub Enterprise (github)
    github_app_id = env.get("GITHUB_APP_ID", "").strip()
    github_app_secret = secret_vars.get("GITHUB_APP_SECRET", "").strip()
    github_url = env.get("GITHUB_URL", "").strip()
    if env.get("GITHUB_ENABLED", "False") == "True" and github_app_id and github_app_secret:
        github_entry = {
            "name": "github",
            "label": env.get("GITHUB_LABEL", "").strip() or "GitHub",
            "app_id": github_app_id,
            "app_secret": github_app_secret,
            "args": {
                "scope": "user:email",
            },
        }
        if github_url:
            github_entry["url"] = github_url
        omniauth_providers.append(github_entry)

    # 6. GitLab.com / External GitLab (gitlab)
    gitlab_oauth_app_id = env.get("GITLAB_OAUTH_APP_ID", "").strip()
    gitlab_oauth_app_secret = secret_vars.get("GITLAB_OAUTH_APP_SECRET", "").strip()
    gitlab_oauth_url = env.get("GITLAB_OAUTH_URL", "").strip()
    if (
        env.get("GITLAB_OAUTH_ENABLED", "False") == "True"
        and gitlab_oauth_app_id
        and gitlab_oauth_app_secret
    ):
        gitlab_oauth_args = {"scope": "read_user"}
        if gitlab_oauth_url:
            gitlab_oauth_args["client_options"] = {"site": gitlab_oauth_url}
        omniauth_providers.append({
            "name": "gitlab",
            "label": env.get("GITLAB_OAUTH_LABEL", "").strip() or "GitLab.com",
            "app_id": gitlab_oauth_app_id,
            "app_secret": gitlab_oauth_app_secret,
            "args": gitlab_oauth_args,
        })

    # 7. Google Workspace / Google OAuth2 (google_oauth2)
    google_client_id = env.get("GOOGLE_CLIENT_ID", "").strip()
    google_client_secret = secret_vars.get("GOOGLE_CLIENT_SECRET", "").strip()
    if env.get("GOOGLE_ENABLED", "False") == "True" and google_client_id and google_client_secret:
        omniauth_providers.append({
            "name": "google_oauth2",
            "label": env.get("GOOGLE_LABEL", "").strip() or "Google",
            "app_id": google_client_id,
            "app_secret": google_client_secret,
            "args": {
                "access_type": "offline",
                "approval_prompt": "",
            },
        })

    # 8. Generic OAuth2 (oauth2_generic)
    oauth2_generic_app_id = env.get("OAUTH2_GENERIC_APP_ID", "").strip()
    oauth2_generic_app_secret = secret_vars.get("OAUTH2_GENERIC_APP_SECRET", "").strip()
    oauth2_generic_site = env.get("OAUTH2_GENERIC_SITE", "").strip()
    if (
        env.get("OAUTH2_GENERIC_ENABLED", "False") == "True"
        and oauth2_generic_app_id
        and oauth2_generic_app_secret
        and oauth2_generic_site
    ):
        omniauth_providers.append({
            "name": "oauth2_generic",
            "label": env.get("OAUTH2_GENERIC_LABEL", "").strip() or "OAuth2",
            "app_id": oauth2_generic_app_id,
            "app_secret": oauth2_generic_app_secret,
            "args": {
                "name": "oauth2_generic",
                "strategy_class": "OmniAuth::Strategies::OAuth2Generic",
                "client_options": {
                    "site": oauth2_generic_site,
                    "authorize_url": env.get("OAUTH2_GENERIC_AUTHORIZE_URL", "").strip() or "/oauth2/v1/authorize",
                    "token_url": env.get("OAUTH2_GENERIC_TOKEN_URL", "").strip() or "/oauth2/v1/token",
                    "user_info_url": env.get("OAUTH2_GENERIC_USER_INFO_URL", "").strip() or "/oauth2/v1/userinfo",
                },
                "user_response_structure": {
                    "root_path": [],
                    "id_path": [env.get("OAUTH2_GENERIC_UID_FIELD", "").strip() or "sub"],
                    "attributes": {
                        "email": "email",
                        "name": "name",
                    },
                },
            },
        })

if sso_enabled and omniauth_providers:
    active_provider_names = [prov["name"] for prov in omniauth_providers]
    sso_allow_sso = env.get("SSO_ALLOW_SINGLE_SIGN_ON", "True") == "True"
    sso_block_auto = env.get("SSO_BLOCK_AUTO_CREATED_USERS", "False") == "True"
    sso_bypass_2fa = env.get("SSO_ALLOW_BYPASS_TWO_FACTOR", "True") == "True"
    sso_auto_link = env.get("SSO_AUTO_LINK_USER", "True") == "True"
    sso_auto_link_ldap = env.get("SSO_AUTO_LINK_LDAP_USER", "True") == "True"
    sso_auto_link_saml = env.get("SSO_AUTO_LINK_SAML_USER", "True") == "True"
    sso_sync_profile = env.get("SSO_SYNC_PROFILE", "True") == "True"
    sso_auto_sign_in = env.get("SSO_AUTO_SIGN_IN_PROVIDER", "").strip()

    lines.extend([
        "",
        "# Single Sign-On (OmniAuth)",
        "gitlab_rails['omniauth_enabled'] = true",
        f"gitlab_rails['omniauth_allow_single_sign_on'] = {ruby_json(active_provider_names) if sso_allow_sso else 'false'}",
        f"gitlab_rails['omniauth_block_auto_created_users'] = {'true' if sso_block_auto else 'false'}",
        f"gitlab_rails['omniauth_allow_bypass_two_factor'] = {ruby_json(active_provider_names) if sso_bypass_2fa else 'false'}",
        f"gitlab_rails['omniauth_auto_link_user'] = {ruby_json(active_provider_names) if sso_auto_link else 'false'}",
        f"gitlab_rails['omniauth_auto_link_ldap_user'] = {'true' if sso_auto_link_ldap else 'false'}",
        f"gitlab_rails['omniauth_auto_link_saml_user'] = {'true' if sso_auto_link_saml else 'false'}",
        f"gitlab_rails['omniauth_sync_email_from_provider'] = {ruby_json(active_provider_names) if sso_sync_profile else 'false'}",
        f"gitlab_rails['omniauth_sync_profile_from_provider'] = {ruby_json(active_provider_names) if sso_sync_profile else 'false'}",
        f"gitlab_rails['omniauth_sync_profile_attributes'] = {ruby_json(['name', 'email'] if sso_sync_profile else [])}",
    ])
    if sso_auto_sign_in and sso_auto_sign_in in active_provider_names:
        lines.append(f"gitlab_rails['omniauth_auto_sign_in_with_provider'] = {ruby_str(sso_auto_sign_in)}")
    lines.append(f"gitlab_rails['omniauth_providers'] = {ruby_json(omniauth_providers)}")

if smtp_settings.get("enabled"):
    smtp_host = smtp_settings.get("host", "")
    if smtp_host in ("127.0.0.1", "localhost"):
        smtp_host = "10.0.2.2"
    smtp_port = int(smtp_settings.get("port") or 25)
    smtp_user = smtp_settings.get("username", "")
    smtp_pass = smtp_settings.get("password", "")
    encrypt_smtp = str(smtp_settings.get("encrypt_smtp", "none")).lower()
    tls_verify = bool(smtp_settings.get("tls_verify", False))

    smtp_tls = encrypt_smtp in ("tls", "ssl") or smtp_port == 465
    smtp_starttls = encrypt_smtp == "starttls" and not smtp_tls
    verify_mode = "peer" if tls_verify else "none"

    lines.extend([
        "",
        "# Smarthost / SMTP Configuration",
        "gitlab_rails['smtp_enable'] = true",
        f"gitlab_rails['smtp_address'] = {ruby_str(smtp_host)}",
        f"gitlab_rails['smtp_port'] = {smtp_port}",
        f"gitlab_rails['gitlab_email_from'] = {ruby_str(f'gitlab@{host}')}",
        f"gitlab_rails['smtp_tls'] = {'true' if smtp_tls else 'false'}",
        f"gitlab_rails['smtp_enable_starttls_auto'] = {'true' if smtp_starttls else 'false'}",
        f"gitlab_rails['smtp_openssl_verify_mode'] = {ruby_str(verify_mode)}",
    ])
    if smtp_user:
        lines.extend([
            f"gitlab_rails['smtp_user_name'] = {ruby_str(smtp_user)}",
            f"gitlab_rails['smtp_password'] = {ruby_str(smtp_pass)}",
            "gitlab_rails['smtp_authentication'] = 'login'",
        ])
else:
    lines.extend([
        "",
        "gitlab_rails['smtp_enable'] = false",
    ])

lines.extend([
    "",
    "# Persistent Custom Omnibus Configuration",
    'from_file "/etc/gitlab/gitlab-custom.rb" if File.exist?("/etc/gitlab/gitlab-custom.rb")',
])

file_path = "gitlab.rb"
tmpfile = f".gitlab.rb-{os.getpid()}.tmp"
with open(tmpfile, "w", encoding="utf-8", newline="\n") as ofile:
    for line in lines:
        ofile.write(f"{line}\n")
os.chmod(tmpfile, 0o600)
os.replace(tmpfile, file_path)
