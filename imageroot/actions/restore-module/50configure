import os
import sys
import agent
import agent.tasks

env = dict(os.environ)
if os.path.exists("environment"):
    try:
        env.update(agent.read_envfile("environment"))
    except Exception as ex:
        print(agent.SD_WARNING + f"Failed to read environment file: {ex}", file=sys.stderr)

host = env.get("HOST", "")
if host:
    agent.set_env("RESTORE_SKIP_MISSING_IDP", "1")
    agent.dump_env()

    configure_retval = agent.tasks.run(
        agent_id=os.environ["AGENT_ID"],
        action="configure-module",
        data={
            "host": host,
            "http2https": env.get("HTTP2HTTPS", "True") == "True",
            "lets_encrypt": env.get("LETS_ENCRYPT", "False") == "True",
            "ldap_domain": env.get("LDAP_DOMAIN", ""),
            "registry_host": env.get("GITLAB_REGISTRY_HOST", ""),
            "runner_enabled": env.get("RUNNER_ENABLED", "True") == "True",
            "password": "",
            "sso_enabled": env.get("SSO_ENABLED", "False") == "True",
            "sso_allow_single_sign_on": env.get("SSO_ALLOW_SINGLE_SIGN_ON", "True") == "True",
            "sso_block_auto_created_users": env.get("SSO_BLOCK_AUTO_CREATED_USERS", "False") == "True",
            "sso_allow_bypass_two_factor": env.get("SSO_ALLOW_BYPASS_TWO_FACTOR", "True") == "True",
            "sso_auto_link_user": env.get("SSO_AUTO_LINK_USER", "True") == "True",
            "sso_auto_link_ldap_user": env.get("SSO_AUTO_LINK_LDAP_USER", "True") == "True",
            "sso_auto_link_saml_user": env.get("SSO_AUTO_LINK_SAML_USER", "True") == "True",
            "sso_sync_profile": env.get("SSO_SYNC_PROFILE", "True") == "True",
            "sso_auto_sign_in_provider": env.get("SSO_AUTO_SIGN_IN_PROVIDER", ""),
            "ns8_sso_provider": env.get("NS8_SSO_PROVIDER", ""),
            "ns8_sso_label": env.get("NS8_SSO_LABEL") or "Single Sign-On",
            "oidc_enabled": env.get("OIDC_ENABLED", "False") == "True",
            "oidc_label": env.get("OIDC_LABEL") or "OpenID Connect",
            "oidc_issuer": env.get("OIDC_ISSUER", ""),
            "oidc_client_id": env.get("OIDC_CLIENT_ID", ""),
            "oidc_pkce": env.get("OIDC_PKCE", "True") == "True",
            "oidc_uid_field": env.get("OIDC_UID_FIELD") or "preferred_username",
            "oidc_scopes": env.get("OIDC_SCOPES") or "openid,profile,email",
            "oidc_client_auth_method": env.get("OIDC_CLIENT_AUTH_METHOD") or "basic",
            "saml_enabled": env.get("SAML_ENABLED", "False") == "True",
            "saml_label": env.get("SAML_LABEL") or "SAML 2.0",
            "saml_idp_sso_target_url": env.get("SAML_IDP_SSO_TARGET_URL", ""),
            "saml_idp_slo_target_url": env.get("SAML_IDP_SLO_TARGET_URL", ""),
            "saml_issuer": env.get("SAML_ISSUER", ""),
            "saml_idp_cert_fingerprint": env.get("SAML_IDP_CERT_FINGERPRINT", ""),
            "saml_name_identifier_format": env.get("SAML_NAME_IDENTIFIER_FORMAT")
            or "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
            "azure_enabled": env.get("AZURE_ENABLED", "False") == "True",
            "azure_label": env.get("AZURE_LABEL") or "Microsoft Entra ID",
            "azure_client_id": env.get("AZURE_CLIENT_ID", ""),
            "azure_tenant_id": env.get("AZURE_TENANT_ID", ""),
            "github_enabled": env.get("GITHUB_ENABLED", "False") == "True",
            "github_label": env.get("GITHUB_LABEL") or "GitHub",
            "github_app_id": env.get("GITHUB_APP_ID", ""),
            "github_url": env.get("GITHUB_URL", ""),
            "gitlab_oauth_enabled": env.get("GITLAB_OAUTH_ENABLED", "False") == "True",
            "gitlab_oauth_label": env.get("GITLAB_OAUTH_LABEL") or "GitLab.com",
            "gitlab_oauth_app_id": env.get("GITLAB_OAUTH_APP_ID", ""),
            "gitlab_oauth_url": env.get("GITLAB_OAUTH_URL", ""),
            "google_enabled": env.get("GOOGLE_ENABLED", "False") == "True",
            "google_label": env.get("GOOGLE_LABEL") or "Google",
            "google_client_id": env.get("GOOGLE_CLIENT_ID", ""),
            "oauth2_generic_enabled": env.get("OAUTH2_GENERIC_ENABLED", "False") == "True",
            "oauth2_generic_label": env.get("OAUTH2_GENERIC_LABEL") or "OAuth2",
            "oauth2_generic_app_id": env.get("OAUTH2_GENERIC_APP_ID", ""),
            "oauth2_generic_site": env.get("OAUTH2_GENERIC_SITE", ""),
            "oauth2_generic_authorize_url": env.get("OAUTH2_GENERIC_AUTHORIZE_URL") or "/oauth2/v1/authorize",
            "oauth2_generic_token_url": env.get("OAUTH2_GENERIC_TOKEN_URL") or "/oauth2/v1/token",
            "oauth2_generic_user_info_url": env.get("OAUTH2_GENERIC_USER_INFO_URL") or "/oauth2/v1/userinfo",
            "oauth2_generic_uid_field": env.get("OAUTH2_GENERIC_UID_FIELD") or "sub",
        },
    )
    agent.assert_exp(configure_retval["exit_code"] == 0, "The configure-module subtask failed!")
