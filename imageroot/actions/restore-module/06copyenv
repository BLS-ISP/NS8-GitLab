import os
import sys
import json
import agent

request = json.load(sys.stdin)
original_environment = request.get("environment", {})

for evar in [
    "HOST",
    "HTTP2HTTPS",
    "LETS_ENCRYPT",
    "LDAP_DOMAIN",
    "GITLAB_REGISTRY_HOST",
    "RUNNER_ENABLED",
]:
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])

agent.dump_env()

# Migrate legacy GITLAB_INITIAL_PASSWORD from pre-1.0.5 backups into passwords.env if needed
if "GITLAB_INITIAL_PASSWORD" in original_environment and not os.path.exists("passwords.env"):
    agent.write_envfile(
        "passwords.env",
        {"GITLAB_INITIAL_PASSWORD": original_environment["GITLAB_INITIAL_PASSWORD"]},
    )
    os.chmod("passwords.env", 0o600)
