import sys
import json
import agent

request = json.load(sys.stdin)
original_environment = request.get("environment", {})

for evar in [
    "HOST",
    "HTTP2HTTPS",
    "LETS_ENCRYPT",
    "LDAP_DOMAIN",
    "GITLAB_REGISTRY_HOST",
    "RUNNER_ENABLED",
    "GITLAB_INITIAL_PASSWORD",
]:
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])

agent.dump_env()
