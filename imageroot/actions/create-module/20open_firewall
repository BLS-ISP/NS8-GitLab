import os
import agent

tcp_ports = [p.strip() for p in os.environ.get("TCP_PORTS", "").split(",") if p.strip()]
ssh_tcp_port = os.environ.get("GITLAB_SSH_PORT") or (tcp_ports[2] if len(tcp_ports) >= 3 else None)

if ssh_tcp_port:
    agent.assert_exp(
        agent.add_public_service(
            os.environ["MODULE_ID"],
            [f"{ssh_tcp_port}/tcp"],
        ),
        "Firewall service configuration has failed",
    )
