import os
import sys
import json
import secrets
import agent

data = json.load(sys.stdin)

tcp_ports = [p.strip() for p in os.environ.get("TCP_PORTS", "").split(",") if p.strip()]
if len(tcp_ports) >= 1:
    agent.set_env("GITLAB_NGINX_PORT", tcp_ports[0])
if len(tcp_ports) >= 2:
    agent.set_env("GITLAB_REGISTRY_PORT", tcp_ports[1])
if len(tcp_ports) >= 3:
    agent.set_env("GITLAB_SSH_PORT", tcp_ports[2])

agent.set_env("HTTP2HTTPS", "True")
agent.set_env("LETS_ENCRYPT", "False")
agent.set_env("RUNNER_ENABLED", "True")
agent.set_env("GITLAB_INITIAL_PASSWORD", secrets.token_urlsafe(16))
agent.dump_env()
