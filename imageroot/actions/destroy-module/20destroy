import os
import sys
import json
import agent
import agent.tasks

data = json.load(sys.stdin)

# Remove public firewall service
try:
    agent.remove_public_service(os.environ["MODULE_ID"])
except Exception as ex:
    print(f"Warning: failed to remove firewall service: {ex}", file=sys.stderr)

# Unbind LDAP user domains
try:
    agent.unbind_user_domains()
except Exception:
    pass

# Find default traefik instance for current node
default_traefik_id = agent.resolve_agent_id("traefik@node")
if default_traefik_id is not None:
    agent.tasks.run(
        agent_id=default_traefik_id,
        action="delete-route",
        data={
            "instance": os.environ["MODULE_ID"],
        },
    )

    if os.environ.get("GITLAB_REGISTRY_HOST"):
        agent.tasks.run(
            agent_id=default_traefik_id,
            action="delete-route",
            data={
                "instance": os.environ["MODULE_ID"] + "-registry",
            },
        )
