{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure gitlab",
    "$id": "http://nethserver.org/json-schema/task/input/gitlab/configure",
    "description": "Configure gitlab",
    "examples": [
        {
            "host": "git.nethserver.org",
            "http2https": true,
            "lets_encrypt": true,
            "runner_enabled": true
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for gitlab, like 'git.nethserver.org'",
            "format": "hostname",
            "pattern": "\\."
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "password": {
            "description": "Gitlab initial root password (min 8 characters if set)",
            "anyOf": [
                {
                    "type": "string",
                    "maxLength": 0
                },
                {
                    "type": "string",
                    "minLength": 8
                }
            ]
        },
        "ldap_domain": {
            "type": "string",
            "description": "LDAP-Domain for authentication"
        },
        "registry_host": {
            "description": "Host name for gitlab registry, like 'registry.nethserver.org'",
            "anyOf": [
                {
                    "type": "string",
                    "maxLength": 0
                },
                {
                    "type": "string",
                    "format": "hostname",
                    "pattern": "\\."
                }
            ]
        },
        "runner_enabled": {
            "type": "boolean",
            "title": "Enable GitLab Runner",
            "description": "Start and register an integrated GitLab Runner container"
        }
    }
}
