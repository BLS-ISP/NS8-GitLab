import json
import sys
import os
import secrets
import agent
import agent.tasks

data = json.load(sys.stdin)

host = (data.get("host") or "").strip()
ldap_domain = (data.get("ldap_domain") or "").strip()
registry_host = (data.get("registry_host") or "").strip()
initial_password = (data.get("password") or "").strip()
http2https = bool(data.get("http2https", True))
lets_encrypt = bool(data.get("lets_encrypt", False))
runner_enabled = bool(data.get("runner_enabled", True))

tcp_ports = [p.strip() for p in os.environ.get("TCP_PORTS", "").split(",") if p.strip()]
server_port = tcp_ports[0] if len(tcp_ports) >= 1 else os.environ.get("GITLAB_NGINX_PORT", "20000")
registry_port = tcp_ports[1] if len(tcp_ports) >= 2 else os.environ.get("GITLAB_REGISTRY_PORT", "20001")
ssh_port = tcp_ports[2] if len(tcp_ports) >= 3 else os.environ.get("GITLAB_SSH_PORT", "20002")

validation_errors = []

if host and registry_host and host.lower() == registry_host.lower():
    validation_errors.append({
        "field": "registry_host",
        "parameter": "registry_host",
        "value": registry_host,
        "error": "registry_host_must_differ_from_host",
    })

if (not os.environ.get("HOST") or host != os.environ.get("HOST")) and agent.http_route_in_use(domain=host):
    validation_errors.append({
        "field": "host",
        "parameter": "host",
        "value": host,
        "error": "domain_already_used_in_traefik",
    })

if registry_host and (not os.environ.get("GITLAB_REGISTRY_HOST") or registry_host != os.environ.get("GITLAB_REGISTRY_HOST")) and agent.http_route_in_use(domain=registry_host):
    validation_errors.append({
        "field": "registry_host",
        "parameter": "registry_host",
        "value": registry_host,
        "error": "domain_already_used_in_traefik",
    })

if validation_errors:
    agent.set_status("validation-failed")
    json.dump(validation_errors, fp=sys.stdout)
    sys.exit(2)

if not initial_password:
    initial_password = os.environ.get("GITLAB_INITIAL_PASSWORD") or secrets.token_urlsafe(16)

agent.set_env("HOST", host)
agent.set_env("HTTP2HTTPS", str(http2https))
agent.set_env("LETS_ENCRYPT", str(lets_encrypt))
agent.set_env("GITLAB_NGINX_PORT", server_port)
agent.set_env("GITLAB_REGISTRY_PORT", registry_port)
agent.set_env("GITLAB_SSH_PORT", ssh_port)
agent.set_env("LDAP_DOMAIN", ldap_domain)
agent.set_env("GITLAB_REGISTRY_HOST", registry_host)
agent.set_env("RUNNER_ENABLED", str(runner_enabled))
agent.set_env("GITLAB_INITIAL_PASSWORD", initial_password)
agent.dump_env()
