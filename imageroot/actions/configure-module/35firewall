import os
import agent

ssh_port = os.environ.get("GITLAB_SSH_PORT", "").strip()
if ssh_port:
    agent.assert_exp(
        agent.add_public_service(
            os.environ["MODULE_ID"],
            [f"{ssh_port}/tcp"],
            replace_ports=True,
        ),
        "Firewall service configuration has failed",
    )
