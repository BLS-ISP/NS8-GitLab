set -e

# Redirect any output to the journal (stderr)
exec 1>&2

systemctl --user daemon-reload

# Start or restart GitLab Pod and Server
systemctl --user enable gitlab.service gitlab-app.service
systemctl --user restart gitlab.service

if [[ "${RUNNER_ENABLED:-True}" == "True" ]]; then
    systemctl --user enable --now podman.socket
    systemctl --user enable --now gitlab-runner.service
    systemctl --user restart gitlab-runner.service
    systemctl --user start --no-block gitlab-runner-register.service || true
else
    systemctl --user disable --now gitlab-runner-register.service 2>/dev/null || true
    systemctl --user disable --now gitlab-runner.service 2>/dev/null || true
fi
