import json
import os
import subprocess
import sys
import agent

data = json.load(sys.stdin)
new_password = (data.get("password") or "").strip()

# Generate gitlab.rb using shared write-config helper
bin_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "bin"))
subprocess.run([sys.executable, os.path.join(bin_dir, "write-config")], check=True)

# If a new password was explicitly entered and gitlab-app is already running and bootstrapped,
# update the root user's password via stdin + env-file (never exposing the password in ps argv).
if new_password and len(new_password) >= 8 and os.path.exists("passwords.env"):
    chk = subprocess.run(
        ["podman", "inspect", "-f", "{{.State.Running}}", "gitlab-app"],
        capture_output=True,
        text=True,
    )
    if chk.returncode == 0 and chk.stdout.strip() == "true":
        bootstrapped = subprocess.run(
            ["podman", "exec", "gitlab-app", "test", "-f", "/var/opt/gitlab/bootstrapped"],
            capture_output=True,
            text=True,
        )
        if bootstrapped.returncode == 0:
            ruby_script = (
                "pw = ENV.fetch('GITLAB_INITIAL_PASSWORD')\n"
                "u = User.find_by(username: 'root') || User.admins.first\n"
                "raise 'Root user not found' unless u\n"
                "u.password = pw\n"
                "u.password_confirmation = pw\n"
                "u.save!\n"
            )
            res = subprocess.run(
                [
                    "podman",
                    "exec",
                    "-i",
                    "--env-file=passwords.env",
                    "gitlab-app",
                    "gitlab-rails",
                    "runner",
                    "-e",
                    "production",
                    "-",
                ],
                input=ruby_script,
                stdout=sys.stderr,
                stderr=sys.stderr,
                text=True,
            )
            if res.returncode != 0:
                print(agent.SD_ERR + "Failed to update GitLab root password via gitlab-rails runner", file=sys.stderr)
                sys.exit(res.returncode)
