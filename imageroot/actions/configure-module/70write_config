import json
import os
import subprocess
import sys

data = json.load(sys.stdin)
new_password = (data.get("password") or "").strip()

# Generate gitlab.rb using shared write-config helper
bin_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "bin"))
subprocess.run([sys.executable, os.path.join(bin_dir, "write-config")], check=True)

# If a new password was explicitly entered and gitlab-app is already running,
# update the root user's password in GitLab as well
if new_password and len(new_password) >= 8:
    chk = subprocess.run(
        ["podman", "inspect", "-f", "{{.State.Running}}", "gitlab-app"],
        capture_output=True,
        text=True,
    )
    if chk.returncode == 0 and chk.stdout.strip() == "true":
        ruby_pw = json.dumps(new_password)
        cmd = [
            "podman", "exec", "gitlab-app",
            "gitlab-rails", "runner", "-e", "production",
            f"u = User.find_by(username: 'root') || User.admins.first; if u; u.password = {ruby_pw}; u.password_confirmation = {ruby_pw}; u.save!; end",
        ]
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
