import os
import agent
import agent.tasks

host = os.environ.get("HOST", "")
if host:
    configure_retval = agent.tasks.run(
        agent_id=os.environ["AGENT_ID"],
        action="configure-module",
        data={
            "host": host,
            "http2https": os.environ.get("HTTP2HTTPS", "True") == "True",
            "lets_encrypt": os.environ.get("LETS_ENCRYPT", "False") == "True",
            "ldap_domain": os.environ.get("LDAP_DOMAIN", ""),
            "registry_host": os.environ.get("GITLAB_REGISTRY_HOST", ""),
            "runner_enabled": os.environ.get("RUNNER_ENABLED", "True") == "True",
            "password": "",
        },
    )
    agent.assert_exp(configure_retval["exit_code"] == 0, "The configure-module subtask failed!")
