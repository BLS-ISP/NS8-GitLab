import json
import os
import subprocess
import sys
import agent
import agent.tasks

event = json.load(sys.stdin)

env = dict(os.environ)
if os.path.exists("environment"):
    try:
        env.update(agent.read_envfile("environment"))
    except Exception as ex:
        print(agent.SD_WARNING + f"Failed to read environment file: {ex}", file=sys.stderr)

ns8_sso_provider = env.get("NS8_SSO_PROVIDER", "").strip()
if not ns8_sso_provider or str(event.get("module_id") or "").strip() != ns8_sso_provider:
    sys.exit(0)

passwords_file = "passwords.env"


def clear_ns8_sso_credentials():
    agent.unset_env("NS8_SSO_ISSUER")
    agent.unset_env("NS8_SSO_CLIENT_ID")
    agent.dump_env()
    if os.path.exists(passwords_file):
        try:
            secret_vars = agent.read_envfile(passwords_file)
            if "NS8_SSO_CLIENT_SECRET" in secret_vars:
                secret_vars.pop("NS8_SSO_CLIENT_SECRET", None)
                agent.write_envfile(passwords_file, secret_vars)
                os.chmod(passwords_file, 0o600)
        except Exception as ex:
            print(agent.SD_WARNING + f"Failed to update {passwords_file}: {ex}", file=sys.stderr)


event_host = str(event.get("host") or "").strip()
gitlab_host = env.get("HOST", "").strip()
ldap_domain = env.get("LDAP_DOMAIN", "").strip()
sso_enabled = env.get("SSO_ENABLED", "False") == "True"

if not event_host:
    print(
        agent.SD_WARNING
        + f"OIDC provider '{ns8_sso_provider}' disabled or cleared host; clearing active NS8 SSO credentials",
        file=sys.stderr,
    )
    clear_ns8_sso_credentials()
elif sso_enabled and gitlab_host and ldap_domain:
    response = agent.tasks.run(
        agent_id=f"module/{ns8_sso_provider}",
        action="register-client",
        data={
            "domain": ldap_domain,
            "redirect_uris": [f"https://{gitlab_host}/users/auth/openid_connect_ns8/callback"],
            "post_logout_redirect_uris": [f"https://{gitlab_host}/"],
        },
    )
    agent.assert_exp(response["exit_code"] == 0, f"Failed to re-register OIDC client on {ns8_sso_provider}")

    raw_output = response.get("output") or {}
    if isinstance(raw_output, str):
        try:
            raw_output = json.loads(raw_output) if raw_output.strip() else {}
        except Exception as ex:
            print(agent.SD_WARNING + f"Failed to decode register-client JSON output: {ex}", file=sys.stderr)
            raw_output = {}

    client_id = str(raw_output.get("client_id") or env.get("MODULE_ID", "")).strip()
    client_secret = str(raw_output.get("client_secret") or "").replace("\r", "").replace("\n", "").strip()
    issuer = str(
        raw_output.get("issuer")
        or raw_output.get("issuer_url")
        or event.get("issuer_url")
        or event.get("issuer_url_prefix")
        or f"https://{event_host}"
    ).strip()

    agent.assert_exp(
        bool(client_id and client_secret and issuer),
        f"Incomplete OIDC credentials returned by {ns8_sso_provider}",
    )

    secret_vars = {}
    if os.path.exists(passwords_file):
        try:
            secret_vars.update(agent.read_envfile(passwords_file))
        except Exception as ex:
            print(agent.SD_WARNING + f"Failed to read {passwords_file}: {ex}", file=sys.stderr)

    secret_vars["NS8_SSO_CLIENT_SECRET"] = client_secret
    agent.write_envfile(passwords_file, secret_vars)
    os.chmod(passwords_file, 0o600)

    agent.set_env("NS8_SSO_CLIENT_ID", client_id)
    agent.set_env("NS8_SSO_ISSUER", issuer)
    agent.dump_env()
else:
    clear_ns8_sso_credentials()

if gitlab_host:
    bin_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "bin"))
    subprocess.run(
        [sys.executable, os.path.join(bin_dir, "write-config")],
        stdout=sys.stderr,
        stderr=sys.stderr,
        check=True,
    )

is_active = subprocess.run(
    ["systemctl", "--user", "is-active", "--quiet", "gitlab.service"],
    stdout=sys.stderr,
    stderr=sys.stderr,
)
if is_active.returncode == 0:
    agent.run_helper("systemctl", "--user", "restart", "gitlab-app.service").check_returncode()
